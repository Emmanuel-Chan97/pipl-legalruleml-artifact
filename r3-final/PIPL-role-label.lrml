              </ruleml:Atom>
            </ruleml:Or>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-10-b">
      <lrml:Comment>第10条｜非法买卖、提供或公开他人个人信息</lrml:Comment>
      <ruleml:Rule closure="universal">
