    <lrml:PrescriptiveStatement key="r-27-a">
      <lrml:Comment>第27条｜在合理范围内处理个人自行公开或其他已经合法公开的信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>27.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Or key=":r-27-a-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>个人自行公开相关信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>其他已经合法公开相关信息</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX27-REFUSAL</ruleml:Data>
              <ruleml:Data>27.a</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Permission key="r-27-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-27-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-27-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>在合理范围内处理</ruleml:Data>
              <ruleml:Data>个人自行公开或者其他已合法公开的信息</ruleml:Data>
            </ruleml:Atom>
          </lrml:Permission>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-27-c">
      <lrml:Comment>第27条｜依法获得个人同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>27.c</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-27-c-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>处理已公开的个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>对个人权益有重大影响</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-27-c-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-27-c-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-27-c-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>依法取得</ruleml:Data>
              <ruleml:Data>个人同意</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="r-28-1">
      <lrml:Comment>第28条第1款｜泄露或非法使用容易危及人格尊严、人身或财产安全的信息被归入敏感信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>28.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>28.1</ruleml:Data>
              <ruleml:Data>第二十八条　敏感个人信息是一旦泄露或者非法使用，容易导致自然人的人格尊严受到侵害或者人身、财产安全受到危害的个人信息，包括生物识别、宗教信仰、特定身份、医疗健康、金融账户、行踪轨迹等信息，以及不满十四周岁未成年人的个人信息。</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-28-1-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>敏感个人信息</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="r-29-a">
      <lrml:Comment>第29条｜取得个人的单独同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>29.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-29-a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理敏感个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-29-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-29-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-29-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>取得</ruleml:Data>
              <ruleml:Data>个人的单独同意</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-30">
      <lrml:Comment>第30条｜在 §17 第1款事项之外，告知敏感信息处理的必要性及其对个人权益的影响</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>30</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-30-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理敏感个人信息</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX30-NOTICE-WAIVER</ruleml:Data>
              <ruleml:Data>30</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-30-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-30-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-30-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>在第17条第一款事项之外追加告知</ruleml:Data>
              <ruleml:Data>处理敏感信息的必要性及对个人权益的影响</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-31-1">
      <lrml:Comment>第31条第1款｜取得未成年人父母或其他监护人同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>31.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-31-1-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理不满十四周岁未成年人的个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-31-1-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-31-1-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-31-1-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>取得</ruleml:Data>
              <ruleml:Data>父母或者其他监护人的同意</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-31-2">
      <lrml:Comment>第31条第2款｜制定专门的个人信息处理规则</lrml:Comment>
      <ruleml:Rule closure="universal">
