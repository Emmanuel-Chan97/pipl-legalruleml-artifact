              <ruleml:Data>个人信息保护负责人的姓名、联系方式等</ruleml:Data>
              <ruleml:Data>履行个人信息保护职责的部门</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-53-a">
      <lrml:Comment>第53条｜在中国境内设立专门机构或指定代表，以处理个人信息保护事务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>53.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>适用域外条款的境外处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-53-a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>属于第3条第二款规定的境外处理者</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-53-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-53-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Or key=":r-53-a-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>设立</ruleml:Data>
                <ruleml:Data>中华人民共和国境内的专门机构</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>指定</ruleml:Data>
                <ruleml:Data>中华人民共和国境内的代表</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-53-b">
      <lrml:Comment>第53条｜报送机构名称或代表姓名及联系方式等</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>53.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>适用域外条款的境外处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-53-b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>属于第3条第二款规定的境外处理者</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-53-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-53-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-53-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>报送</ruleml:Data>
              <ruleml:Data>境内机构名称或者代表姓名及联系方式等</ruleml:Data>
              <ruleml:Data>履行个人信息保护职责的部门</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-54">
      <lrml:Comment>第54条｜定期审计处理活动对法律、行政法规的遵守情况。时间限定（文本元数据） 定期（作用于合规审计）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>54</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
