              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>履职部门依法履行职责</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-63-par2a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-63-par2a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-63-par2a-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>协助</ruleml:Data>
                <ruleml:Data>依法履行职责</ruleml:Data>
                <ruleml:Data>履职部门</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>配合</ruleml:Data>
                <ruleml:Data>依法履行职责</ruleml:Data>
                <ruleml:Data>履职部门</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-63-par2b">
      <lrml:Comment>第63条第2款｜拒绝或阻挠履职</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>63.par2b</ruleml:Data>
              <ruleml:Data>在有关部门的法定职责、管辖范围及适用程序内；依本条确定主体与处置范围。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>有关当事人</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-63-par2b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>履职部门依法履行职责</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-63-par2b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-63-par2b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Or key=":r-63-par2b-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>拒绝</ruleml:Data>
                <ruleml:Data>履职部门依法履行职责</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>阻挠</ruleml:Data>
                <ruleml:Data>履职部门依法履行职责</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-64-1c">
      <lrml:Comment>第64条第1款｜依要求采取措施，整改并消除隐患</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>64.1c</ruleml:Data>
              <ruleml:Data>在有关部门的法定职责、管辖范围及适用程序内；依本条确定主体与处置范围。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-64-1c-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>履职部门依法提出相应整改要求</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-64-1c-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-64-1c-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-64-1c-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>按照要求采取</ruleml:Data>
                <ruleml:Data>措施</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>进行</ruleml:Data>
                <ruleml:Data>整改</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>消除</ruleml:Data>
                <ruleml:Data>隐患</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-64-2">
      <lrml:Comment>第64条第2款｜及时移送公安机关依法处理。时间限定（文本元数据） 及时（作用于移送公安机关）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>64.2</ruleml:Data>
              <ruleml:Data>在有关部门的法定职责、管辖范围及适用程序内；依本条确定主体与处置范围。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>履行个人信息保护职责的部门</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-64-2-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>在履行职责中发现违法处理个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>涉嫌犯罪</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-64-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-64-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-64-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>移送</ruleml:Data>
              <ruleml:Data>涉嫌犯罪的违法处理个人信息事项</ruleml:Data>
              <ruleml:Data>公安机关</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-65-1b">
      <lrml:Comment>第65条第1款｜依法及时处理投诉、举报并反馈结果。时间限定（文本元数据） 及时（作用于依法处理投诉、举报）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>65.1b</ruleml:Data>
              <ruleml:Data>在有关部门的法定职责、管辖范围及适用程序内；依本条确定主体与处置范围。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>接收投诉举报的履职部门</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-65-1b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>收到投诉、举报</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-65-1b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-65-1b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-65-1b-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>依法处理</ruleml:Data>
                <ruleml:Data>收到的投诉、举报</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>告知</ruleml:Data>
                <ruleml:Data>处理结果</ruleml:Data>
                <ruleml:Data>投诉、举报人</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-65-2">
      <lrml:Comment>第65条第2款｜公开投诉、举报受理联系方式</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>65.2</ruleml:Data>
              <ruleml:Data>在有关部门的法定职责、管辖范围及适用程序内；依本条确定主体与处置范围。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>履行个人信息保护职责的部门</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-65-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-65-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-65-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>公布</ruleml:Data>
              <ruleml:Data>接受投诉、举报的联系方式</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="r-72-1">
      <lrml:Comment>第72条第1款｜排除本法适用</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>72.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-72-1-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>自然人因个人或者家庭事务处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-72-1-content">
            <ruleml:Rel iri="urn:pipl:projection:state_text"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>不适用</ruleml:Data>
            <ruleml:Data>本法</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-72-2">
      <lrml:Comment>第72条第2款｜适用法律对相关个人信息处理作出的规定</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>72.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-72-2-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Entity</ruleml:Var>
                <ruleml:Data>各级政府及有关部门组织实施统计、档案管理活动中的个人信息处理</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Entity</ruleml:Var>
                <ruleml:Data>法律对此有规定</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-72-2-content">
            <ruleml:Rel iri="urn:pipl:projection:state_text"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>适用</ruleml:Data>
            <ruleml:Data>有关法律对统计、档案管理个人信息处理活动的规定</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-73-1">
      <lrml:Comment>第73条第1项｜指在处理活动中自主决定处理目的和处理方式的组织或个人</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>73.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>73.1</ruleml:Data>
              <ruleml:Data>（一）个人信息处理者，是指在个人信息处理活动中自主决定处理目的、处理方式的组织、个人。</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-73-1-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>个人信息处理者</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-73-2">
      <lrml:Comment>第73条第2项｜用计算机程序自动分析、评估个人行为习惯、兴趣爱好、经济、健康、信用等情况并作出决策</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>73.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>73.2</ruleml:Data>
              <ruleml:Data>（二）自动化决策，是指通过计算机程序自动分析、评估个人的行为习惯、兴趣爱好或者经济、健康、信用状况等，并进行决策的活动。</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-73-2-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>自动化决策</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-73-3">
      <lrml:Comment>第73条第3项｜处理后在不借助额外信息时不能识别特定自然人</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>73.3</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>73.3</ruleml:Data>
              <ruleml:Data>（三）去标识化，是指个人信息经过处理，使其在不借助额外信息的情况下无法识别特定自然人的过程。</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-73-3-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>去标识化</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-73-4">
      <lrml:Comment>第73条第4项｜处理后不能识别特定自然人且无法复原</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>73.4</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>73.4</ruleml:Data>
              <ruleml:Data>（四）匿名化，是指个人信息经过处理无法识别特定自然人且不能复原的过程。</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-73-4-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>匿名化</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
  </lrml:Statements>
</lrml:LegalRuleML>
