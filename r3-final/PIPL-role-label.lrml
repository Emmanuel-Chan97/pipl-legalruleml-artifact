          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-40-a">
      <lrml:Comment>第40条｜将中国境内收集和产生的个人信息存储在境内</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>40.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>关键信息基础设施运营者或达到规定数量的个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Or key=":r-40-a-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>主体为关键信息基础设施运营者</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>主体处理数量达到国家网信部门依第40条规定的门槛</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-40-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-40-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-40-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>存储</ruleml:Data>
              <ruleml:Data>在境内收集和产生的个人信息，存储地点为中华人民共和国境内</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-40-b">
      <lrml:Comment>第40条｜通过国家网信部门组织的出境安全评估</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>40.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>关键信息基础设施运营者或达到规定数量的个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-40-b-activation">
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>主体为关键信息基础设施运营者</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>主体处理数量达到国家网信部门依第40条规定的门槛</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>确需向境外提供本条所涉信息</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>E40-ASSESSMENT</ruleml:Data>
              <ruleml:Data>40.b</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-40-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-40-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-40-b-content">
              <ruleml:Rel iri="urn:pipl:projection:state_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>通过</ruleml:Data>
              <ruleml:Data>国家网信部门组织的安全评估</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-41-b">
      <lrml:Comment>第41条｜向外国司法或执法机构提供存储于中国境内的个人信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>41.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-41-b-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>拟向外国司法或执法机构提供境内存储的个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Neg>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>中华人民共和国主管机关已批准</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Neg>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-41-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-41-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-41-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>提供</ruleml:Data>
              <ruleml:Data>存储于中华人民共和国境内的个人信息</ruleml:Data>
              <ruleml:Data>外国司法或者执法机构</ruleml:Data>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-45-1">
      <lrml:Comment>第45条第1款｜向处理者查阅、复制本人个人信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>45.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:claim_relationship_roles"/>
              <ruleml:Var>Claimant</ruleml:Var>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
              <ruleml:Data>个人</ruleml:Data>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-45-1-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Claimant</ruleml:Var>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
              <ruleml:Data>涉及该个人自身且由该处理者处理的个人信息</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Claimant</ruleml:Var>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
              <ruleml:Data>E45-ACCESS</ruleml:Data>
              <ruleml:Data>45.1</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Right>
            <ruleml:slot>
              <lrml:Bearer key="r-45-1-participants"/>
              <ruleml:Var>Claimant</ruleml:Var>
            </ruleml:slot>
            <ruleml:slot>
              <lrml:AuxiliaryParty/>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-45-1-content">
              <ruleml:Rel iri="urn:pipl:projection:exercise_right_text"/>
              <ruleml:Var>Claimant</ruleml:Var>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
              <ruleml:Data>查阅</ruleml:Data>
              <ruleml:Data>本人个人信息</ruleml:Data>
            </ruleml:Atom>
          </lrml:Right>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-45-1-copy">
      <lrml:Comment>第45条第1款｜向处理者查阅、复制本人个人信息</lrml:Comment>
