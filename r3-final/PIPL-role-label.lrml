            </ruleml:Atom>
            <ruleml:Or key=":r-55-b-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>处理敏感个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>利用个人信息进行自动化决策</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>委托处理</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>向其他处理者提供</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>公开个人信息</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>向中华人民共和国境外提供个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>其他对个人权益有重大影响的处理活动</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-55-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-55-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-55-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>记录</ruleml:Data>
              <ruleml:Data>个人信息处理情况</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-56-1">
      <lrml:Comment>第56条第1款｜评估须覆盖：处理目的、方式等的合法性、正当性和必要性；对个人权益的影响和安全风险；措施的合法性、有效性及与风险程度的适配</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>56.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-56-1-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>实施个人信息保护影响评估</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-56-1-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-56-1-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-56-1-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>评估包括</ruleml:Data>
                <ruleml:Data>处理目的、处理方式等是否合法、正当、必要</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>评估包括</ruleml:Data>
                <ruleml:Data>对个人权益的影响及安全风险</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>评估包括</ruleml:Data>
                <ruleml:Data>保护措施是否合法、有效并与风险程度相适应</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-56-2">
      <lrml:Comment>第56条第2款｜至少保存3年评估报告及处理记录。时间限定（文本元数据） 至少三年（作用于保存评估报告及处理记录）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>56.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-56-2-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>形成个人信息保护影响评估报告和处理情况记录</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-56-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-56-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-56-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>保存</ruleml:Data>
              <ruleml:Data>个人信息保护影响评估报告和处理情况记录</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-58-1a">
      <lrml:Comment>第58条第（一）项｜依国家规定建立健全个人信息保护合规体系</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>58.1a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>符合第58条条件的平台处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-58-1a-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>提供重要互联网平台服务</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>用户数量巨大</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>业务类型复杂</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-58-1a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-58-1a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-58-1a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>按照国家规定建立健全</ruleml:Data>
              <ruleml:Data>个人信息保护合规制度体系</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-58-1b">
      <lrml:Comment>第58条第（一）项｜成立以外部成员为主的独立机构，监督个人信息保护情况</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>58.1b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>符合第58条条件的平台处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-58-1b-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>提供重要互联网平台服务</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>用户数量巨大</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>业务类型复杂</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-58-1b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-58-1b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-58-1b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>成立</ruleml:Data>
              <ruleml:Data>主要由外部成员组成、对个人信息保护情况进行监督的独立机构</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-58-2">
      <lrml:Comment>第58条第（二）项｜按公开、公平、公正原则制定平台规则，明确平台内产品或服务提供者的处理规范及保护义务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>58.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>符合第58条条件的平台处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-58-2-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>提供重要互联网平台服务</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>用户数量巨大</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>业务类型复杂</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-58-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-58-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-58-2-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>制定</ruleml:Data>
                <ruleml:Data>平台规则（遵循公开、公平、公正原则）</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>明确</ruleml:Data>
                <ruleml:Data>平台内提供者处理信息的规范和保护信息的义务</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-58-3">
      <lrml:Comment>第58条第（三）项｜停止向有关平台内产品或服务提供者供应平台服务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>58.3</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>符合第58条条件的平台处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-58-3-activation">
              <ruleml:And>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>提供重要互联网平台服务</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>用户数量巨大</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>业务类型复杂</ruleml:Data>
                </ruleml:Atom>
              </ruleml:And>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>平台内提供者严重违反法律、行政法规处理个人信息</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-58-3-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-58-3-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-58-3-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>停止提供</ruleml:Data>
              <ruleml:Data>平台服务</ruleml:Data>
              <ruleml:Data>严重违法处理信息的平台内产品或者服务提供者</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-58-4">
      <lrml:Comment>第58条第（四）项｜定期公布个人信息保护社会责任报告，接受社会监督。时间限定（文本元数据） 定期（作用于发布社会责任报告）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>58.4</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>符合第58条条件的平台处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-58-4-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>提供重要互联网平台服务</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>用户数量巨大</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>业务类型复杂</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-58-4-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-58-4-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-58-4-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>发布</ruleml:Data>
                <ruleml:Data>个人信息保护社会责任报告</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>接受</ruleml:Data>
                <ruleml:Data>社会监督</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-59-a">
      <lrml:Comment>第59条｜按照本法和相关法律、行政法规采取必要措施，保护受托处理的信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>59.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>受托人</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-59-a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>接受委托处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-59-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-59-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-59-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>依法采取必要措施保障</ruleml:Data>
              <ruleml:Data>受托处理的个人信息安全</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-59-b">
      <lrml:Comment>第59条｜协助委托处理者履行其在本法下的义务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>59.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>受托人</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-59-b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>接受委托处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-59-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-59-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-59-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>协助履行</ruleml:Data>
              <ruleml:Data>本法规定的个人信息保护义务</ruleml:Data>
              <ruleml:Data>委托处理者</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="r-60-3">
      <lrml:Comment>第60条第3款｜以本条前两款所述有关部门作为该法定称谓的指称范围</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>60.3</ruleml:Data>
              <ruleml:Data>在有关部门的法定职责、管辖范围及适用程序内；依本条确定主体与处置范围。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>60.3</ruleml:Data>
              <ruleml:Data>国家网信部门负责统筹协调个人信息保护工作和相关监督管理工作。国务院有关部门依照本法和有关法律、行政法规的规定，在各自职责范围内负责个人信息保护和监督管理工作。
县级以上地方人民政府有关部门的个人信息保护和监督管理职责，按照国家有关规定确定。
前两款规定的部门统称为履行个人信息保护职责的部门。</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-60-3-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>履行个人信息保护职责的部门</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="r-63-par2a">
      <lrml:Comment>第63条第2款｜协助并配合履职部门</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>63.par2a</ruleml:Data>
              <ruleml:Data>在有关部门的法定职责、管辖范围及适用程序内；依本条确定主体与处置范围。</ruleml:Data>
