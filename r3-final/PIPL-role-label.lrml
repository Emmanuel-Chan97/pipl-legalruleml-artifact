    <lrml:PrescriptiveStatement key="r-47-1a">
      <lrml:Comment>第47条第1款｜主动删除个人信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>47.1a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条适用排除、角色及相关特别规定。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Or key=":r-47-1a-activation">
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理目的已实现</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理目的无法实现</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>为实现目的已不再必要</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理者停止提供产品或者服务</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>保存期限已届满</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>个人撤回同意</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理违反法律、行政法规</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理违反约定</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>法律、行政法规规定其他删除情形</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>E47-DELETION-LIMIT</ruleml:Data>
              <ruleml:Data>47.1a</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-47-1a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-47-1a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-47-1a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>主动删除</ruleml:Data>
              <ruleml:Data>符合本条删除条件的个人信息</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-47-1b">
