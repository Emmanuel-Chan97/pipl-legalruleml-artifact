    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-23-c">
      <lrml:Comment>第23条｜在告知的目的、方式和信息种类等范围内处理</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>23.c</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>接收方处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-23-c-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>作为接收方取得本条所涉个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
