            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-24-1a">
      <lrml:Comment>第24条第1款｜保障决策透明与结果公平、公正</lrml:Comment>
      <ruleml:Rule closure="universal">
