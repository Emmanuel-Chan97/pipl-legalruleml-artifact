            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-9-b">
      <lrml:Comment>第9条｜采取必要措施保护正在处理的个人信息</lrml:Comment>
