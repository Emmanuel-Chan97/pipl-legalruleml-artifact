            </ruleml:slot>
            <ruleml:Atom key=":r-10-c-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>从事</ruleml:Data>
              <ruleml:Data>危害国家安全、公共利益的个人信息处理活动</ruleml:Data>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-13-2a">
      <lrml:Comment>第13条第2款｜依本法有关规定取得个人的同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>13.2a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-13-2a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>依照本法其他有关规定处理时要求取得同意</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX13-CONSENT</ruleml:Data>
              <ruleml:Data>13.2a</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-13-2a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-13-2a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-13-2a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>取得</ruleml:Data>
              <ruleml:Data>个人同意</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-14-2">
      <lrml:Comment>第14条第2款｜取得新的个人同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>14.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-14-2-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>处理以个人同意为依据</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理目的发生变更</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理方式发生变更</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理的个人信息种类发生变更</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-14-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-14-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-14-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>重新取得</ruleml:Data>
              <ruleml:Data>个人同意</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-15-1b">
      <lrml:Comment>第15条第1款｜提供便捷的撤回渠道</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>15.1b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-15-1b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理基于个人同意</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-15-1b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-15-1b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-15-1b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>提供</ruleml:Data>
              <ruleml:Data>便捷的撤回同意方式</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-16">
      <lrml:Comment>第16条｜以个人拒绝同意或撤回同意为理由拒供产品或服务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>16</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Or key=":r-16-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>个人不同意处理其个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>个人撤回同意</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX16-NECESSARY</ruleml:Data>
              <ruleml:Data>16</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-16-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-16-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-16-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>以不同意或撤回同意为由拒绝提供</ruleml:Data>
              <ruleml:Data>产品或者服务</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-17-1">
      <lrml:Comment>第17条第1款｜在处理前，以显著方式和易懂语言真实、准确、完整地告知处理者身份和联系方式、处理目的和方式、信息种类、保存期限、行权方式和程序以及其他法定事项。时间限定（文本元数据） 处理个人信息前（作用于告知第17条第一款事项）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>17.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-17-1-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>将要处理个人信息</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX18-CONFIDENTIAL</ruleml:Data>
              <ruleml:Data>17.1</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX35-PUBLIC-NOTICE</ruleml:Data>
              <ruleml:Data>17.1</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-17-1-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-17-1-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-17-1-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>以显著方式、清晰易懂语言真实准确完整地告知</ruleml:Data>
              <ruleml:Data>处理者身份及联系方式、处理目的和方式、信息种类和保存期限、行权方式程序、其他法定事项</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-17-2">
      <lrml:Comment>第17条第2款｜将变更部分告知个人</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>17.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-17-2-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>前款规定事项发生变更</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-17-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-17-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-17-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>告知</ruleml:Data>
              <ruleml:Data>第17条第一款告知事项的变更部分</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-17-3">
      <lrml:Comment>第17条第3款｜公开处理规则，并让规则便于查阅、保存</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>17.3</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-17-3-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理者通过制定处理规则告知第17条第一款事项</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-17-3-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-17-3-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-17-3-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>公开</ruleml:Data>
                <ruleml:Data>个人信息处理规则</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>便于查阅</ruleml:Data>
                <ruleml:Data>处理规则</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>便于保存</ruleml:Data>
                <ruleml:Data>处理规则</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-18-1">
      <lrml:Comment>第18条第1款｜可以省略 §17 第1款所列事项的告知</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>18.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Or key=":r-18-1-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>法律、行政法规规定应当保密</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>法律、行政法规规定不需要告知</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Permission key="r-18-1-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-18-1-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Neg key=":r-18-1-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>告知</ruleml:Data>
                <ruleml:Data>第17条第一款规定的事项</ruleml:Data>
                <ruleml:Data>个人</ruleml:Data>
              </ruleml:Atom>
            </ruleml:Neg>
          </lrml:Permission>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-18-2">
      <lrml:Comment>第18条第2款｜紧急情况结束后及时告知。时间限定（文本元数据） 紧急情况消除后（作用于告知）；及时（作用于告知）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>18.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-18-2-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>紧急情况下为保护生命健康和财产安全</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>无法及时向个人告知</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>紧急情况消除</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-18-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-18-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-18-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>告知</ruleml:Data>
              <ruleml:Data>第17条第一款事项</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-19">
      <lrml:Comment>第19条｜将信息保存期限制为实现处理目的所需的最短时间。时间限定（文本元数据） 实现处理目的所必要的最短时间（作用于个人信息保存期限）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>19</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-19-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>保存个人信息</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX19-OTHER-LAW</ruleml:Data>
              <ruleml:Data>19</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-19-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-19-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-19-content">
              <ruleml:Rel iri="urn:pipl:projection:state_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>为实现处理目的所必要的最短时间</ruleml:Data>
              <ruleml:Data>个人信息保存期限</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-20-1a">
      <lrml:Comment>第20条第1款｜约定各共同处理者的权利和义务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>20.1a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>共同决定处理目的和方式的两个以上处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-20-1a-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>两个以上个人信息处理者</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>共同决定个人信息的处理目的和处理方式</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-20-1a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-20-1a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-20-1a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>约定</ruleml:Data>
              <ruleml:Data>各自的权利和义务</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-22-a">
      <lrml:Comment>第22条｜告知接收方名称或姓名及联系方式</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>22.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>转移方处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-22-a-activation">
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理者合并</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理者分立</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理者解散</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>处理者被宣告破产</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>条文所涉其他业务变化原因</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>需要转移个人信息</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-22-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-22-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-22-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>告知</ruleml:Data>
              <ruleml:Data>接收方名称或者姓名及联系方式</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-22-b">
      <lrml:Comment>第22条｜继续履行个人信息处理者的义务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>22.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>接收方</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-22-b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>因第22条所述原因接收转移的个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-22-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-22-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-22-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_actor_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>继续履行</ruleml:Data>
              <ruleml:Data>个人信息处理者的义务</ruleml:Data>
              <ruleml:Data>接收方</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-22-c">
      <lrml:Comment>第22条｜依法取得新的个人同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>22.c</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>接收方</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-22-c-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>依第22条接收转移的信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>变更原先处理目的</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>变更原先处理方式</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-22-c-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-22-c-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-22-c-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_actor_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>重新取得</ruleml:Data>
              <ruleml:Data>个人同意</ruleml:Data>
              <ruleml:Data>接收方</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-23-a">
      <lrml:Comment>第23条｜告知接收方名称或姓名及联系方式、其处理目的和方式、转供信息的种类</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>23.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>提供方处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-23-a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>向其他个人信息处理者提供其处理的个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-23-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-23-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-23-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>告知</ruleml:Data>
              <ruleml:Data>接收方名称或者姓名、联系方式、处理目的、处理方式和信息种类</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-23-b">
      <lrml:Comment>第23条｜取得个人的单独同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>23.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
