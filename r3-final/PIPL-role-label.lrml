              <ruleml:Data>31.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-31-2-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理不满十四周岁未成年人的个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-31-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-31-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-31-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>制定</ruleml:Data>
              <ruleml:Data>专门的个人信息处理规则</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="r-33">
      <lrml:Comment>第33条｜国家机关处理个人信息适用本法，本节具有相应特别规定时适用本节</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>33</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-33-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>国家机关处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-33-content">
            <ruleml:Rel iri="urn:pipl:projection:state_text"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>适用</ruleml:Data>
            <ruleml:Data>本法及本节特别规定</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="r-34-a">
      <lrml:Comment>第34条｜按法律、行政法规所定职权及程序处理信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>34.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-34-a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关为履行法定职责处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-34-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-34-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-34-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_actor_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>依照法定权限和程序进行</ruleml:Data>
              <ruleml:Data>个人信息处理</ruleml:Data>
              <ruleml:Data>国家机关</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-34-b">
      <lrml:Comment>第34条｜超出履行法定职责所需的范围和限度而处理信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>34.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-34-b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关为履行法定职责处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-34-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-34-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-34-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_actor_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>超出履行法定职责所必需的范围和限度处理</ruleml:Data>
              <ruleml:Data>个人信息</ruleml:Data>
              <ruleml:Data>国家机关</ruleml:Data>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-35">
      <lrml:Comment>第35条｜履行本法规定的告知义务</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>35</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-35-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关为履行法定职责处理个人信息</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>EX35-PUBLIC-NOTICE</ruleml:Data>
              <ruleml:Data>35</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-35-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-35-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-35-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_actor_label_with_recipient_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>履行</ruleml:Data>
              <ruleml:Data>本法规定的告知义务</ruleml:Data>
              <ruleml:Data>国家机关</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-36-a">
      <lrml:Comment>第36条｜将处理的个人信息存储于中国境内</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>36.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-36-a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>国家机关处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-36-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-36-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-36-a-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_actor_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>在中华人民共和国境内存储</ruleml:Data>
              <ruleml:Data>国家机关处理的个人信息</ruleml:Data>
              <ruleml:Data>国家机关</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-36-b">
      <lrml:Comment>第36条｜进行安全评估。时间限定（文本元数据） 向境外提供前的安全评估要求（作用于安全评估）</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
