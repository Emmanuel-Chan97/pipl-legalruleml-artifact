    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="r-37">
      <lrml:Comment>第37条｜适用本法关于国家机关处理的规则</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
