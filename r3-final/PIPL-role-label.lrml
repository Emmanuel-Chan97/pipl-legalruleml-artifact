              <ruleml:Data>个人信息</ruleml:Data>
              <ruleml:Data>接收方</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-23-d">
      <lrml:Comment>第23条｜依法取得新的个人同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>23.d</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>接收方处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-23-d-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>作为接收方取得本条所涉个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>变更原先处理目的</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Bearer</ruleml:Var>
                  <ruleml:Data>变更原先处理方式</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-23-d-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-23-d-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-23-d-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text_with_actor_label"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>重新取得</ruleml:Data>
