                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>核实</ruleml:Data>
                <ruleml:Data>所请求更正、补充的个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>更正、补充</ruleml:Data>
                <ruleml:Data>经核实需要更正、补充的个人信息</ruleml:Data>
