      <lrml:appliesSource keyref="#cite-fragment-73-aa29dea701"/>
      <lrml:toTarget keyref="#r-73-4-content"/>
    </lrml:Association>
  </lrml:Associations>
  <lrml:Statements>
    <lrml:PrescriptiveStatement key="r-21-1a">
      <lrml:Comment>与受托人约定委托目的、期限、处理方式、信息种类、保护措施和双方的权利义务等。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-21-1a" closure="universal">
        <ruleml:if>
          <ruleml:Atom key=":r-21-1a-activation">
            <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment"/>
            <ruleml:Var>Controller</ruleml:Var>
            <ruleml:Var>Entrusted</ruleml:Var>
            <ruleml:Var>Contract</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-21-1a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-21-1a-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-21-1a-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:agree_on_required_entrustment_terms"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-21-1b">
      <lrml:Comment>处理者监督受托人的处理活动。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-21-1b" closure="universal">
        <ruleml:if>
          <ruleml:Atom key=":r-21-1b-activation">
            <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment"/>
            <ruleml:Var>Controller</ruleml:Var>
            <ruleml:Var>Entrusted</ruleml:Var>
            <ruleml:Var>Contract</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-21-1b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-21-1b-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-21-1b-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:supervise_entrusted_processing"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-21-2a">
      <lrml:Comment>受托人按照约定处理个人信息。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-21-2a" closure="universal">
        <ruleml:if>
          <ruleml:And key=":r-21-2a-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrusted_activity"/>
              <ruleml:Var>Contract</ruleml:Var>
              <ruleml:Var>Activity</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-21-2a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-21-2a-participants"/>
              <ruleml:Var>Entrusted</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-21-2a-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:process_under_agreed_terms"/>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Activity</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-21-2b">
      <lrml:Comment>受托人不得超出约定的处理目的、处理方式等进行处理。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-21-2b" closure="universal">
        <ruleml:if>
          <ruleml:And key=":r-21-2b-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrusted_activity"/>
              <ruleml:Var>Contract</ruleml:Var>
              <ruleml:Var>Activity</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-21-2b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-21-2b-participants"/>
              <ruleml:Var>Entrusted</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-21-2b-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:process_beyond_agreed_scope"/>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Activity</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-21-2c">
      <lrml:Comment>合同不生效、无效、被撤销或终止时，返还和删除是同一项义务的两种履行方式。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-21-2c" closure="universal">
        <ruleml:if>
          <ruleml:And key=":r-21-2c-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrusted_data"/>
              <ruleml:Var>Contract</ruleml:Var>
              <ruleml:Var>Data</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_not_in_force"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_invalid"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_revoked"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_terminated"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-21-2c-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-21-2c-participants"/>
              <ruleml:Var>Entrusted</ruleml:Var>
            </ruleml:slot>
            <ruleml:Or key=":r-21-2c-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:return_personal_information"/>
                <ruleml:Var>Entrusted</ruleml:Var>
                <ruleml:Var>Controller</ruleml:Var>
                <ruleml:Var>Data</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:delete_personal_information"/>
                <ruleml:Var>Entrusted</ruleml:Var>
                <ruleml:Var>Data</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-21-2d">
      <lrml:Comment>上述任一合同情形下，单独禁止保留。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-21-2d" closure="universal">
        <ruleml:if>
          <ruleml:And key=":r-21-2d-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Contract</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:entrusted_data"/>
              <ruleml:Var>Contract</ruleml:Var>
              <ruleml:Var>Data</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_not_in_force"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_invalid"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_revoked"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment_contract_terminated"/>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Or>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-21-2d-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-21-2d-participants"/>
              <ruleml:Var>Entrusted</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-21-2d-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:retain_personal_information"/>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>Data</ruleml:Var>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-21-3a">
      <lrml:Comment>未经个人信息处理者同意，受托人不得转委托。条件用显式否定区分已知未同意与信息未知。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-21-3a" closure="universal">
        <ruleml:if>
          <ruleml:And key=":r-21-3a-activation">
            <ruleml:And>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrustment"/>
                <ruleml:Var>Controller</ruleml:Var>
                <ruleml:Var>Entrusted</ruleml:Var>
                <ruleml:Var>Contract</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:entrusted_activity"/>
                <ruleml:Var>Contract</ruleml:Var>
                <ruleml:Var>Activity</ruleml:Var>
              </ruleml:Atom>
            </ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:subdelegation_candidate"/>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>ThirdParty</ruleml:Var>
              <ruleml:Var>Activity</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Neg>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:controller_consents_to_subdelegation"/>
                <ruleml:Var>Controller</ruleml:Var>
                <ruleml:Var>Entrusted</ruleml:Var>
                <ruleml:Var>ThirdParty</ruleml:Var>
                <ruleml:Var>Activity</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-21-3a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-21-3a-participants"/>
              <ruleml:Var>Entrusted</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-21-3a-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:subdelegate_processing"/>
              <ruleml:Var>Entrusted</ruleml:Var>
              <ruleml:Var>ThirdParty</ruleml:Var>
              <ruleml:Var>Activity</ruleml:Var>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-57-1a">
      <lrml:Comment>发生或可能发生个人信息泄露、篡改或丢失时，立即采取补救措施。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-57-1a" closure="universal">
        <ruleml:if>
          <ruleml:Atom key=":r-57-1a-activation">
            <ruleml:Rel iri="urn:pipl-pilot:predicate:incident_occurred_or_possible"/>
            <ruleml:Var>Controller</ruleml:Var>
            <ruleml:Var>Event</ruleml:Var>
          </ruleml:Atom>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-57-1a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-57-1a-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-57-1a-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:take_immediate_remedial_measures"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-57-1b">
      <lrml:Comment>通知履职部门。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-57-1b" closure="universal">
        <ruleml:if>
          <ruleml:And key=":r-57-1b-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:incident_occurred_or_possible"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:competent_department"/>
              <ruleml:Var>Department</ruleml:Var>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-57-1b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-57-1b-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-57-1b-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:notify_department"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Department</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-57-1c">
      <lrml:Comment>通知受影响个人。适用个人通知例外的规则优先关系。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-57-1c" closure="universal">
        <lrml:hasStrength>
          <lrml:DefeasibleStrength/>
        </lrml:hasStrength>
        <ruleml:if>
          <ruleml:And key=":r-57-1c-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:incident_occurred_or_possible"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:affected_person"/>
              <ruleml:Var>Person</ruleml:Var>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-57-1c-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-57-1c-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-57-1c-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:notify_person"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Person</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-57-1d">
      <lrml:Comment>第57条下的通知应包括事件相关信息、减害措施和处理者联系方式。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-57-1d" closure="universal">
        <ruleml:if>
          <ruleml:And key=":r-57-1d-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:incident_occurred_or_possible"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:notification_under_article57"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Recipient</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
              <ruleml:Var>Notification</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-57-1d-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-57-1d-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-57-1d-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:state_information_type_cause_and_possible_harm"/>
                <ruleml:Var>Notification</ruleml:Var>
                <ruleml:Var>Event</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:state_controller_remedial_and_person_mitigation_measures"/>
                <ruleml:Var>Notification</ruleml:Var>
                <ruleml:Var>Event</ruleml:Var>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:state_controller_contact_information"/>
                <ruleml:Var>Notification</ruleml:Var>
                <ruleml:Var>Controller</ruleml:Var>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-57-2a">
      <lrml:Comment>有效避免危害时，明确允许省略个人通知。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-57-2a" closure="universal">
        <lrml:hasStrength>
          <lrml:DefeasibleStrength/>
        </lrml:hasStrength>
        <ruleml:if>
          <ruleml:And key=":r-57-2a-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:incident_occurred_or_possible"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:affected_person"/>
              <ruleml:Var>Person</ruleml:Var>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:effective_harm_prevention"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Permission key="r-57-2a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-57-2a-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:Neg key=":r-57-2a-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl-pilot:predicate:notify_person"/>
                <ruleml:Var>Controller</ruleml:Var>
                <ruleml:Var>Person</ruleml:Var>
                <ruleml:Var>Event</ruleml:Var>
              </ruleml:Atom>
            </ruleml:Neg>
          </lrml:Permission>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-57-2c">
      <lrml:Comment>解释重构：对同一处理者、个人及事件，监管机关有效行使要求通知的权能后，发生通知义务。</lrml:Comment>
      <ruleml:Rule key="urn:pipl-pilot:template:r-57-2c" closure="universal">
        <lrml:hasStrength>
          <lrml:DefeasibleStrength/>
        </lrml:hasStrength>
        <ruleml:if>
          <ruleml:And key=":r-57-2c-activation">
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:incident_occurred_or_possible"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:affected_person"/>
              <ruleml:Var>Person</ruleml:Var>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:competent_department"/>
              <ruleml:Var>Department</ruleml:Var>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl-pilot:predicate:valid_notice_order"/>
              <ruleml:Var>Department</ruleml:Var>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Person</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-57-2c-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-57-2c-participants"/>
              <ruleml:Var>Controller</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-57-2c-content">
              <ruleml:Rel iri="urn:pipl-pilot:predicate:notify_person"/>
              <ruleml:Var>Controller</ruleml:Var>
              <ruleml:Var>Person</ruleml:Var>
              <ruleml:Var>Event</ruleml:Var>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:OverrideStatement>
      <lrml:Comment>个人通知例外只优先于一般个人通知义务。</lrml:Comment>
      <lrml:Override over="#r-57-2a" under="#r-57-1c"/>
    </lrml:OverrideStatement>
    <lrml:OverrideStatement>
      <lrml:Comment>同一主体、对象及事件的有效监管要求优先于省略个人通知的许可。</lrml:Comment>
      <lrml:Override over="#r-57-2c" under="#r-57-2a"/>
    </lrml:OverrideStatement>
    <lrml:PrescriptiveStatement key="r-2">
      <lrml:Comment>第2条｜侵害自然人的个人信息权益</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>任何组织、个人</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-2-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-2-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-2-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>侵害</ruleml:Data>
              <ruleml:Data>自然人的个人信息权益</ruleml:Data>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:ConstitutiveStatement key="r-3-1">
      <lrml:Comment>第3条第1款｜在中国境内处理自然人的个人信息时适用本法</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>3.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-3-1-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>在中华人民共和国境内处理自然人个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-3-1-content">
            <ruleml:Rel iri="urn:pipl:projection:state_text"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>适用本法</ruleml:Data>
            <ruleml:Data>在中华人民共和国境内处理自然人个人信息的活动</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-3-2">
      <lrml:Comment>第3条第2款｜将适用范围延伸至境外对中国境内自然人个人信息的处理</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>3.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-3-2-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Entity</ruleml:Var>
                <ruleml:Data>在中华人民共和国境外处理境内自然人的个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Entity</ruleml:Var>
                  <ruleml:Data>以向境内自然人提供产品或者服务为目的</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Entity</ruleml:Var>
                  <ruleml:Data>分析、评估境内自然人的行为</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Entity</ruleml:Var>
                  <ruleml:Data>法律、行政法规规定的其他情形</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-3-2-content">
            <ruleml:Rel iri="urn:pipl:projection:state_text"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>适用本法</ruleml:Data>
            <ruleml:Data>境外处理境内自然人个人信息的活动</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-4-1">
      <lrml:Comment>第4条第1款｜以电子或其他方式记录、与已识别或可识别自然人有关的信息属于个人信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>4.1</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>4.1</ruleml:Data>
              <ruleml:Data>第四条　个人信息是以电子或者其他方式记录的与已识别或者可识别的自然人有关的各种信息，不包括匿名化处理后的信息。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:exception_does_not_apply"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>EX4-ANON</ruleml:Data>
              <ruleml:Data>4.1</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-4-1-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>个人信息</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:ConstitutiveStatement key="r-4-2">
      <lrml:Comment>第4条第2款｜处理涵盖收集、存储、使用、加工、传输、提供、公开、删除等活动</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>4.2</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:matches_source_definition"/>
              <ruleml:Var>Entity</ruleml:Var>
              <ruleml:Data>4.2</ruleml:Data>
              <ruleml:Data>个人信息的处理包括个人信息的收集、存储、使用、加工、传输、提供、公开、删除等。</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <ruleml:Atom key=":r-4-2-content">
            <ruleml:Rel iri="urn:pipl:projection:classified_as"/>
            <ruleml:Var>Entity</ruleml:Var>
            <ruleml:Data>个人信息处理</ruleml:Data>
          </ruleml:Atom>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:ConstitutiveStatement>
    <lrml:PrescriptiveStatement key="r-5-b">
      <lrml:Comment>第5条｜以误导、欺诈、胁迫等方式处理个人信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>5.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>实施处理的主体</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-5-b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Prohibition key="r-5-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-5-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-5-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>通过误导、欺诈、胁迫等方式处理</ruleml:Data>
              <ruleml:Data>个人信息</ruleml:Data>
            </ruleml:Atom>
          </lrml:Prohibition>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-6-1a">
      <lrml:Comment>第6条第1款｜具有明确、合理的处理目的，且处理与该目的直接相关</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>6.1a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>实施处理的主体</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-6-1a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-6-1a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-6-1a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-6-1a-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>具有明确、合理的目的</ruleml:Data>
                <ruleml:Data>个人信息处理</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>与处理目的直接相关</ruleml:Data>
                <ruleml:Data>个人信息处理</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-6-1b">
      <lrml:Comment>第6条第1款｜采用对个人权益影响最小的处理方式</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>6.1b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>实施处理的主体</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-6-1b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-6-1b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-6-1b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-6-1b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>采取</ruleml:Data>
              <ruleml:Data>对个人权益影响最小的处理方式</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-7-b">
      <lrml:Comment>第7条｜公开个人信息处理规则</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>7.b</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>实施处理的主体</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-7-b-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-7-b-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-7-b-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-7-b-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>公开</ruleml:Data>
              <ruleml:Data>个人信息处理规则</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-7-c">
      <lrml:Comment>第7条（明示事项片段）｜明示处理的目的、方式和范围</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>7.c</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>实施处理的主体</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-7-c-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-7-c-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-7-c-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-7-c-content">
              <ruleml:Rel iri="urn:pipl:projection:action_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>明示</ruleml:Data>
              <ruleml:Data>处理的目的、方式和范围</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-8">
      <lrml:Comment>第8条｜保障信息质量，避免信息不准确或不完整给个人权益带来不利影响</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>8</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>实施处理的主体</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-8-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>处理个人信息</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-8-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-8-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:And key=":r-8-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:state_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>保证质量</ruleml:Data>
                <ruleml:Data>个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>避免</ruleml:Data>
                <ruleml:Data>因个人信息不准确、不完整对个人权益造成不利影响</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-9-a">
      <lrml:Comment>第9条｜对自己开展的个人信息处理承担责任</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>9.a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:has_bearer_role"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom key=":r-9-a-activation">
              <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
              <ruleml:Data>开展个人信息处理活动</ruleml:Data>
            </ruleml:Atom>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Obligation key="r-9-a-modality">
            <ruleml:slot>
              <lrml:Bearer key="r-9-a-participants"/>
              <ruleml:Var>Bearer</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-9-a-content">
              <ruleml:Rel iri="urn:pipl:projection:state_text"/>
              <ruleml:Var>Bearer</ruleml:Var>
