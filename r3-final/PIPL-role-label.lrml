              <ruleml:Data>境外接收方身份及联系方式、目的、方式、信息种类、向其行权的方式和程序等</ruleml:Data>
              <ruleml:Data>个人</ruleml:Data>
            </ruleml:Atom>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-39-b">
      <lrml:Comment>第39条｜取得个人的单独同意</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>39.b</ruleml:Data>
