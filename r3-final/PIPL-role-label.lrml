              </ruleml:Atom>
            </ruleml:Or>
          </lrml:Obligation>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-24-3a">
      <lrml:Comment>第24条第3款｜请求处理者说明该决定</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>24.3a</ruleml:Data>
              <ruleml:Data>在本法第3条适用范围内，并结合第72条及本条所涉主体、活动与信息范围判断。</ruleml:Data>
            </ruleml:Atom>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:claim_relationship_roles"/>
              <ruleml:Var>Claimant</ruleml:Var>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
              <ruleml:Data>个人</ruleml:Data>
              <ruleml:Data>个人信息处理者</ruleml:Data>
            </ruleml:Atom>
            <ruleml:And key=":r-24-3a-activation">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Claimant</ruleml:Var>
                <ruleml:Var>DutyCounterparty</ruleml:Var>
                <ruleml:Data>通过自动化决策方式作出决定</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Claimant</ruleml:Var>
                <ruleml:Var>DutyCounterparty</ruleml:Var>
                <ruleml:Data>决定对个人权益有重大影响</ruleml:Data>
              </ruleml:Atom>
            </ruleml:And>
          </ruleml:And>
        </ruleml:if>
        <ruleml:then>
          <lrml:Right>
            <ruleml:slot>
              <lrml:Bearer key="r-24-3a-participants"/>
              <ruleml:Var>Claimant</ruleml:Var>
            </ruleml:slot>
            <ruleml:slot>
              <lrml:AuxiliaryParty/>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
            </ruleml:slot>
            <ruleml:Atom key=":r-24-3a-content">
              <ruleml:Rel iri="urn:pipl:projection:exercise_right_text"/>
              <ruleml:Var>Claimant</ruleml:Var>
              <ruleml:Var>DutyCounterparty</ruleml:Var>
              <ruleml:Data>请求说明</ruleml:Data>
              <ruleml:Data>对个人权益有重大影响的自动化决定</ruleml:Data>
            </ruleml:Atom>
          </lrml:Right>
        </ruleml:then>
      </ruleml:Rule>
    </lrml:PrescriptiveStatement>
    <lrml:PrescriptiveStatement key="r-25">
      <lrml:Comment>第25条｜公开其处理的个人信息</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
