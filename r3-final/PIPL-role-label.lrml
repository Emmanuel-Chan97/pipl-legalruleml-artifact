                <ruleml:Or>
                  <ruleml:Atom>
                    <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                    <ruleml:Var>Claimant</ruleml:Var>
                    <ruleml:Var>DutyCounterparty</ruleml:Var>
                    <ruleml:Data>处理者停止提供产品或者服务</ruleml:Data>
                  </ruleml:Atom>
                  <ruleml:Atom>
                    <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                    <ruleml:Var>Claimant</ruleml:Var>
                    <ruleml:Var>DutyCounterparty</ruleml:Var>
                    <ruleml:Data>保存期限已届满</ruleml:Data>
                  </ruleml:Atom>
                </ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Claimant</ruleml:Var>
                  <ruleml:Var>DutyCounterparty</ruleml:Var>
                  <ruleml:Data>个人撤回同意</ruleml:Data>
                </ruleml:Atom>
                <ruleml:Or>
                  <ruleml:Atom>
                    <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                    <ruleml:Var>Claimant</ruleml:Var>
                    <ruleml:Var>DutyCounterparty</ruleml:Var>
                    <ruleml:Data>处理违反法律、行政法规</ruleml:Data>
                  </ruleml:Atom>
                  <ruleml:Atom>
                    <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                    <ruleml:Var>Claimant</ruleml:Var>
                    <ruleml:Var>DutyCounterparty</ruleml:Var>
                    <ruleml:Data>处理违反约定</ruleml:Data>
                  </ruleml:Atom>
                </ruleml:Or>
                <ruleml:Atom>
                  <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                  <ruleml:Var>Claimant</ruleml:Var>
                  <ruleml:Var>DutyCounterparty</ruleml:Var>
                  <ruleml:Data>法律、行政法规规定其他删除情形</ruleml:Data>
                </ruleml:Atom>
              </ruleml:Or>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:condition_text"/>
                <ruleml:Var>Claimant</ruleml:Var>
                <ruleml:Var>DutyCounterparty</ruleml:Var>
                <ruleml:Data>处理者尚未删除</ruleml:Data>
