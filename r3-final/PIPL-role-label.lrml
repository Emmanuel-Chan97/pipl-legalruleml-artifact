    <lrml:PrescriptiveStatement key="r-48">
      <lrml:Comment>第48条｜请求处理者解释说明其个人信息处理规则</lrml:Comment>
      <ruleml:Rule closure="universal">
        <ruleml:if>
          <ruleml:And>
            <ruleml:Atom>
              <ruleml:Rel iri="urn:pipl:projection:scope_text"/>
              <ruleml:Data>48</ruleml:Data>
