            <ruleml:Or key=":r-10-a-content">
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>非法收集</ruleml:Data>
                <ruleml:Data>他人个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>非法使用</ruleml:Data>
                <ruleml:Data>他人个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>非法加工</ruleml:Data>
                <ruleml:Data>他人个人信息</ruleml:Data>
              </ruleml:Atom>
              <ruleml:Atom>
                <ruleml:Rel iri="urn:pipl:projection:action_text"/>
                <ruleml:Var>Bearer</ruleml:Var>
                <ruleml:Data>非法传输</ruleml:Data>
